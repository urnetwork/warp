@@ -203,0 +204,180 @@ func (f *fakeTailServer) Reset() {
+type blockingTailServer struct {
+	fakeTailServer
+	ctx         context.Context
+	sendStarted chan struct{}
+	releaseSend chan struct{}
+	startOnce   sync.Once
+}
+
+func newBlockingTailServer(ctx context.Context) *blockingTailServer {
+	return &blockingTailServer{
+		ctx:         ctx,
+		sendStarted: make(chan struct{}),
+		releaseSend: make(chan struct{}),
+	}
+}
+
+func (s *blockingTailServer) Send(response *logproto.TailResponse) error {
+	s.startOnce.Do(func() { close(s.sendStarted) })
+	select {
+	case <-s.ctx.Done():
+		return s.ctx.Err()
+	case <-s.releaseSend:
+		return s.fakeTailServer.Send(response)
+	}
+}
+
+func (s *blockingTailServer) Context() context.Context { return s.ctx }
+
+func (s *blockingTailServer) responseSnapshot() []logproto.TailResponse {
+	s.responsesMu.Lock()
+	defer s.responsesMu.Unlock()
+	responses := make([]logproto.TailResponse, len(s.responses))
+	for i, response := range s.responses {
+		responses[i] = cloneTailResponse(response)
+	}
+	return responses
+}

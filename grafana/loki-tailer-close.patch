+func TestTailerCloseIsIdempotent(t *testing.T) {
+	metrics := NewMetrics(prometheus.NewRegistry())
+	tailer := &Tailer{
+		openStreamIterator: iter.NewMergeEntryIterator(
+			context.Background(),
+			[]iter.EntryIterator{testutil.NewFakeStreamIterator(0, 0)},
+			logproto.FORWARD,
+		),
+		seenStreams: map[uint64]struct{}{},
+		metrics:     metrics,
+	}
+	metrics.tailsActive.Inc()
+	tailer.recordStream(1)
+	tailer.recordStream(2)
+
+	require.NoError(t, tailer.close())

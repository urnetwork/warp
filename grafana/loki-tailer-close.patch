+func testTailStream(sequence int) logproto.Stream {
+	return logproto.Stream{
+		Labels: `{type="test"}`,
+		Entries: []logproto.Entry{{
+			Timestamp: time.Unix(0, int64(sequence+1)),
+			Line:      fmt.Sprintf("line %d", sequence),
+		}},
+	}
+}

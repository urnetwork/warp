+func TestTailerResponseHandoffAbsorbsShortBurst(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := newBlockingTailServer(ctx)
+	expr, err := syntax.ParseLogSelector(`{type="test"}`, true)
+	require.NoError(t, err)
+	tail, err := newTailer("org-id", expr, server, 100)
+	require.NoError(t, err)
+
+	loopDone := make(chan struct{})
+	go func() {
+		tail.loop()
+		close(loopDone)
+	}()
+
+	lbs := labels.FromStrings("type", "test")
+	tail.send(testTailStream(0), lbs)
+	select {
+	case <-server.sendStarted:
+	case <-time.After(time.Second):
+		t.Fatal("first tail response did not reach the blocked server")
+	}
+
+	const queuedAfterBlockedSend = bufferSizeForTailResponse + 1
+	for i := 1; i <= queuedAfterBlockedSend; i++ {
+		tail.send(testTailStream(i), lbs)
+	}
+	require.Eventually(t, func() bool {
+		return len(tail.sendChan) == cap(tail.sendChan) && len(tail.queue) == 0
+	}, time.Second, time.Millisecond)
+	require.Nil(t, tail.blockedSince(), "short burst must wait in the existing processing queue")
+
+	close(server.releaseSend)
+	require.Eventually(t, func() bool {
+		return len(server.responseSnapshot()) == queuedAfterBlockedSend+1
+	}, time.Second, time.Millisecond)
+	for _, response := range server.responseSnapshot() {
+		require.Empty(t, response.DroppedStreams)
+	}
+
+	tail.close()
+	select {
+	case <-loopDone:
+	case <-time.After(time.Second):
+		t.Fatal("tail loop did not stop")
+	}
+}

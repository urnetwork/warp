+func TestTailerGenuineBackpressureRemainsBounded(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := newBlockingTailServer(ctx)
+	expr, err := syntax.ParseLogSelector(`{type="test"}`, true)
+	require.NoError(t, err)
+	const maxDroppedStreams = 1000
+	tail, err := newTailer("org-id", expr, server, maxDroppedStreams)
+	require.NoError(t, err)
+
+	loopDone := make(chan struct{})
+	go func() {
+		tail.loop()
+		close(loopDone)
+	}()
+
+	lbs := labels.FromStrings("type", "test")
+	tail.send(testTailStream(0), lbs)
+	select {
+	case <-server.sendStarted:
+	case <-time.After(time.Second):
+		t.Fatal("first tail response did not reach the blocked server")
+	}
+
+	for i := 1; i <= bufferSizeForTailResponse+bufferSizeForTailStream+10; i++ {
+		tail.send(testTailStream(i), lbs)
+	}
+	require.Eventually(t, func() bool { return tail.blockedSince() != nil }, time.Second, time.Millisecond)
+	require.LessOrEqual(t, len(tail.queue), cap(tail.queue))
+	require.LessOrEqual(t, len(tail.sendChan), cap(tail.sendChan))
+	tail.blockedMtx.RLock()
+	droppedStreams := len(tail.droppedStreams)
+	tail.blockedMtx.RUnlock()
+	require.Positive(t, droppedStreams)
+	require.LessOrEqual(t, droppedStreams, maxDroppedStreams)
+
+	close(server.releaseSend)
+	require.Eventually(t, func() bool {
+		for _, response := range server.responseSnapshot() {
+			if len(response.DroppedStreams) > 0 {
+				return true
+			}
+		}
+		return false
+	}, time.Second, time.Millisecond, "dropped-stream metadata was not forwarded after blockage cleared")
+
+	tail.close()
+	select {
+	case <-loopDone:
+	case <-time.After(time.Second):
+		t.Fatal("tail loop did not stop")
+	}
+}

+func TestTailerCanceledContextUnblocksResponseHandoff(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := newBlockingTailServer(ctx)
+	expr, err := syntax.ParseLogSelector(`{type="test"}`, true)
+	require.NoError(t, err)
+	tail, err := newTailer("org-id", expr, server, 10)
+	require.NoError(t, err)
+
+	for i := 0; i < cap(tail.sendChan); i++ {
+		stream := testTailStream(i)
+		tail.sendChan <- &stream
+	}
+	tail.queue <- tailRequest{stream: testTailStream(cap(tail.sendChan)), lbs: labels.FromStrings("type", "test")}
+
+	receiveDone := make(chan struct{})
+	go func() {
+		tail.receiveStreamsLoop()
+		close(receiveDone)
+	}()
+	require.Eventually(t, func() bool { return len(tail.queue) == 0 }, time.Second, time.Millisecond)
+
+	cancel()
+	select {
+	case <-receiveDone:
+	case <-time.After(time.Second):
+		t.Fatal("response handoff did not stop after cancellation")
+	}
+}

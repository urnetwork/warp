diff --git a/pkg/querier/tail/tail_test.go b/pkg/querier/tail/tail_test.go
index 52c88fc..6bcdfac 100644
--- a/pkg/querier/tail/tail_test.go
+++ b/pkg/querier/tail/tail_test.go
@@ -3,0 +4,2 @@ import (
+	"bytes"
+	"context"
@@ -8,0 +11,2 @@ import (
+	"github.com/prometheus/client_golang/prometheus"
+	prometheus_testutil "github.com/prometheus/client_golang/prometheus/testutil"
@@ -18,0 +23,29 @@ import (
+func TestTailerCloseIsIdempotent(t *testing.T) {
+	metrics := NewMetrics(prometheus.NewRegistry())
+	tailer := &Tailer{
+		openStreamIterator: iter.NewMergeEntryIterator(
+			context.Background(),
+			[]iter.EntryIterator{testutil.NewFakeStreamIterator(0, 0)},
+			logproto.FORWARD,
+		),
+		seenStreams: map[uint64]struct{}{},
+		metrics:     metrics,
+	}
+	metrics.tailsActive.Inc()
+	tailer.recordStream(1)
+	tailer.recordStream(2)
+
+	require.NoError(t, tailer.close())
+	require.NoError(t, tailer.close())
+	require.Equal(t, float64(0), prometheus_testutil.ToFloat64(metrics.tailsActive))
+	require.Equal(t, float64(0), prometheus_testutil.ToFloat64(metrics.tailedStreamsActive))
+}
+
+func TestTailClientReceiveErrorIncludesBackendAddress(t *testing.T) {
+	var output bytes.Buffer
+	logTailClientReceiveError(log.NewLogfmtLogger(&output), "192.0.2.10:6490", errors.New("EOF"))
+	rendered := output.String()
+	require.Contains(t, rendered, "addr=192.0.2.10:6490")
+	require.Contains(t, rendered, "err=EOF")
+}
+
